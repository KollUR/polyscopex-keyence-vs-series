{
  "name": "vs-series",
  "version": "0.0.0",
  "scripts": {
  "start": "npm run start --prefix vs-series-frontend",
  "install-frontend": "npm install --prefix vs-series-frontend",
  "lint": "npm run lint --prefix vs-series-frontend",
  "build-frontend": "npm run build --prefix vs-series-frontend",
  "copy-frontend": "ncp 'vs-series-frontend/dist' 'dist'",
  "write-sbom": "npm run write-sbom-frontend",
  "write-sbom-frontend": "write-ur-packages ./vs-series-frontend/package-lock.json dist",
  "install-backend": "npm install --prefix vs-series-backend",
  "copy-backend": "ncp 'vs-series-backend/dist' dist/vs-series-backend",
  "build-backend": "npm run build --prefix vs-series-backend",
  "prebuild": "npm run clean-dist && npm run clean-target && npm run validate-manifest",
  "build-arm": "export ARCH=linux/arm64 && npm run build",
  "postinstall": "npm run install-frontend && npm run install-backend",
  "build": "npm run build-backend && npm run build-frontend",
  "prepackage": "mkdir -p dist && npm run copy-backend && npm run copy-frontend && npm run copy-manifest && npm run copy-license && npm run write-sbom",
  "postbuild": "npm run package",
  "package": "package-urcap dist target",
  "copy-manifest": "ncp 'manifest.yaml' 'dist/manifest.yaml'",
  "copy-license": "ncp 'LICENSE' 'dist/LICENSE'",
  "clean-dist": "rimraf dist",
  "clean-target": "rimraf target",
  "install-urcap": "install-urcap 'target/vs-series*.urcapx' '../../../manifest-spec-19.11.22.json'",
  "delete-urcap": "delete-urcap keyence vs-series",
  "validate-manifest": "validate-manifest 'manifest.yaml' '../../../manifest-spec-19.11.22.json'"
},
  "private": true,
  "devDependencies": {
  "@universal-robots/urcap-utils": "2.2.5",
  "ncp": "2.0.0",
  "rimraf": "5.0.7"
  }
}
